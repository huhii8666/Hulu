{
  "name": "bluefit-android",
  "version": "1.0.0",
  "private": true,
  "description": "BlueFit Android wrapper built with Capacitor",
  "scripts": {
    "build:web": "node -e \"const fs=require('fs');fs.mkdirSync('www',{recursive:true});for(const f of ['index.html','styles.css','app.js','auth.js','manifest.json','icon.svg'])fs.copyFileSync(f,'www/'+f)\"",
    "android:sync": "npm run build:web && cap sync android"
  },
  "dependencies": {"@capacitor/android": "^7.0.0","@capacitor/core": "^7.0.0"},
  "devDependencies": {"@capacitor/cli": "^7.0.0"}
}
